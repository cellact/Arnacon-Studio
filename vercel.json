{
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/host/index.html" },
    { "source": "/app", "destination": "/host/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.mjs",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/host/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
