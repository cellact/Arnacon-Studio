{
  "id": "email-support-inbox",
  "title": "Email support inbox",
  "prompt": "A support inbox that only talks to customers by email identity.",
  "spec": {
    "version": 1,
    "kind": "communication-client",
    "app": {
      "name": "Support Inbox",
      "summary": "Email-identity customer threads. No groups, no calls."
    },
    "runtime": {
      "mode": "webview"
    },
    "identity": {
      "source": "installed-product",
      "activeKinds": ["email"],
      "addressing": ["email"]
    },
    "sessions": {
      "direct": true,
      "groups": false,
      "rename": true,
      "delete": false
    },
    "messaging": {
      "text": true,
      "files": true,
      "replies": true,
      "edits": false,
      "forwards": false,
      "delete": false,
      "reactions": false,
      "typing": true,
      "readReceipts": true,
      "block": true,
      "reachability": false
    },
    "calls": {
      "voice": false,
      "video": false,
      "mute": false,
      "hold": false,
      "dtmf": false,
      "transfer": false,
      "switchCamera": false,
      "audioDevice": false,
      "dialer": false
    },
    "device": {
      "camera": false,
      "imagePicker": true,
      "contactPicker": true,
      "qr": false,
      "downloadFile": true
    },
    "theme": {
      "preset": "arnacon-default"
    },
    "warnings": []
  }
}
