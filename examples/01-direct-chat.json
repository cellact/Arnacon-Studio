{
  "id": "direct-chat",
  "title": "Minimal 1:1 chat",
  "prompt": "A simple one-to-one chat. Text messages only. No groups, no calls, no files.",
  "spec": {
    "version": 1,
    "kind": "communication-client",
    "app": {
      "name": "Direct Chat",
      "summary": "Minimal 1:1 text chat on an installed Arnacon product."
    },
    "runtime": {
      "mode": "webview"
    },
    "identity": {
      "source": "installed-product",
      "activeKinds": ["arnacon"],
      "addressing": ["temp", "ens"]
    },
    "sessions": {
      "direct": true,
      "groups": false,
      "rename": true,
      "delete": true
    },
    "messaging": {
      "text": true,
      "files": false,
      "replies": true,
      "edits": true,
      "forwards": false,
      "delete": true,
      "reactions": false,
      "typing": true,
      "readReceipts": true,
      "block": false,
      "reachability": false
    },
    "calls": {
      "voice": false,
      "video": false,
      "mute": false,
      "hold": false,
      "dtmf": false,
      "transfer": false,
      "switchCamera": false,
      "audioDevice": false,
      "dialer": false
    },
    "device": {
      "camera": false,
      "imagePicker": false,
      "contactPicker": false,
      "qr": false,
      "downloadFile": false
    },
    "theme": {
      "preset": "arnacon-default"
    },
    "warnings": []
  }
}
