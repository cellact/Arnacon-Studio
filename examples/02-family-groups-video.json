{
  "id": "family-groups-video",
  "title": "Family groups + video",
  "prompt": "A family messenger with group chats, photos, and video calls, no WhatsApp.",
  "spec": {
    "version": 1,
    "kind": "communication-client",
    "app": {
      "name": "Family Chat",
      "summary": "Group chats, photos, video. No WhatsApp."
    },
    "runtime": {
      "mode": "webview"
    },
    "identity": {
      "source": "installed-product",
      "activeKinds": ["arnacon"],
      "addressing": ["ens", "temp"]
    },
    "sessions": {
      "direct": true,
      "groups": true,
      "rename": true,
      "delete": true
    },
    "messaging": {
      "text": true,
      "files": true,
      "replies": true,
      "edits": true,
      "forwards": true,
      "delete": true,
      "reactions": true,
      "typing": true,
      "readReceipts": true,
      "block": true,
      "reachability": false
    },
    "calls": {
      "voice": true,
      "video": true,
      "mute": true,
      "hold": true,
      "dtmf": false,
      "transfer": false,
      "switchCamera": true,
      "audioDevice": true,
      "dialer": false
    },
    "device": {
      "camera": true,
      "imagePicker": true,
      "contactPicker": false,
      "qr": false,
      "downloadFile": true
    },
    "theme": {
      "preset": "arnacon-default"
    },
    "warnings": []
  }
}
